set_global_assignment -name TOP_LEVEL_ENTITY neptuno2_top
set_global_assignment -name SYSTEMVERILOG_FILE neptuno2_top.sv
set_global_assignment -name SDC_FILE minimig_neptunoplus.sdc
set_global_assignment -name VERILOG_MACRO "MINIMIG_ALTERA=1"
set_global_assignment -name VERILOG_MACRO "MINIMIG_CYCLONE4=1"
set_global_assignment -name VERILOG_MACRO "MINIMIG_TOCCATA=1"
