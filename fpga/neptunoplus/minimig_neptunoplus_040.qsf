set_global_assignment -name VERILOG_MACRO "MINIMIG_I2S_AUDIO=1"
set_global_assignment -name VERILOG_MACRO "MINIMIG_CAPTURE_SYNC=1"

# the MC68060-fpga core as a 68040 on an A4000 board, one SDRAM: the line
# port shares the SDRAM's CPU port with TG68K.vhd (m68k_lp_minimig)
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"
set_global_assignment -name VERILOG_MACRO "MINIMIG_M68K_LINEPORT=1"
set_global_assignment -name VERILOG_MACRO "MINIMIG_A4000=1"

